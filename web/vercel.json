{
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/favicon.png",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=604800, stale-while-revalidate=86400" }
      ]
    },
    {
      "source": "/(robots\\.txt|sitemap\\.xml|llms\\.txt)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600" }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/share/t/:slug",
      "destination": "https://api.thescoreboard.in/api/share/t/:slug"
    },
    {
      "source": "/share/m/:matchId",
      "destination": "https://api.thescoreboard.in/api/share/m/:matchId"
    },
    {
      "source": "/share/og/:path*",
      "destination": "https://api.thescoreboard.in/api/share/og/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
